# ---------------------------------------------------------------------------
# Fleet Console — local configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Binding. v1 is localhost-only by design (PRD §11). Do not set 0.0.0.0. ---
API_HOST=127.0.0.1
API_PORT=8080
WEB_PORT=5173

# --- Storage ---
# Root for the SQLite DB, extracted SSH keys, attachments and session recordings.
FLEET_HOME=

# --- Secret vault -----------------------------------------------------------
# Secrets (SSH passwords, key passphrases, sudo passwords, RDP creds) are held
# in an AES-256-GCM vault whose key is scrypt-derived from this passphrase.
# See apps/api/src/secrets/README.md for why this replaced keytar.
# If unset, the API refuses to start rather than storing anything in the clear.
FLEET_VAULT_PASSPHRASE=

# --- Mesh -------------------------------------------------------------------
# Which MeshProvider to activate: netbird | tailscale | none
MESH_PROVIDER=netbird

# NetBird self-hosted control plane. Point this at wherever you deployed the
# stack in deploy/netbird/ — it does NOT have to be this laptop, and generally
# shouldn't be (see deploy/netbird/README.md).
NETBIRD_MGMT_URL=https://netbird.example.com
NETBIRD_PAT=
# Reusable setup key used to enroll hosts during provisioning. Per-host
# overrides come from the inventory's netbird_setup_key column.
NETBIRD_SETUP_KEY=

# Path to the tailscale binary — only used while MESH_PROVIDER=tailscale, or by
# the read-only migration view that tracks which hosts still need moving.
TAILSCALE_BIN=C:\Program Files\Tailscale\tailscale.exe

# --- Remote desktop ---------------------------------------------------------
# guacd runs in Docker and cannot route to mesh IPs on Windows (PRD §14 risk 1).
# The API opens a loopback TCP shim per session and hands guacd that address.
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
# Host:port guacd should dial back to reach the shim. On Docker Desktop this is
# host.docker.internal; on Linux with network_mode:host it is 127.0.0.1.
GUAC_SHIM_ADVERTISE_HOST=host.docker.internal
# HMAC key for the 60s single-use connection tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUAC_TOKEN_SECRET=

# --- Telemetry & benchmarks -------------------------------------------------
TELEMETRY_POLL_MS=15000
MESH_POLL_MS=30000
BENCHMARK_CRON=0 * * * *
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma4:e2b

# --- Agent ------------------------------------------------------------------
# always_ask | writes_only | allowlist   (PRD §F7 — the gate is not bypassable)
AGENT_APPROVAL_MODE=always_ask
# Model driving the agent loop. Defaults to each host's own Ollama. Set to a
# stronger model if E2B mis-forms tool calls (PRD §14).
AGENT_MODEL=
AGENT_MODEL_BASE_URL=
